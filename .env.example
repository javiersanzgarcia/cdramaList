# Client ID público de Google (OAuth, tipo «Aplicación web»).
# Ejemplo: 1234567890-abc123.apps.googleusercontent.com
#
# La sincronización guarda los datos en Google Drive usando el permiso
# https://www.googleapis.com/auth/drive.appdata. Activa la Google Drive API
# y añade ese permiso en la pantalla de consentimiento OAuth.
#
# En local, copia este archivo a .env y pega tu Client ID.
# En GitHub Pages, crea la variable de repositorio VITE_GOOGLE_CLIENT_ID
# en Settings → Secrets and variables → Actions → Variables.
VITE_GOOGLE_CLIENT_ID=

# Clave de YouTube Data API v3 (empieza por AIza…).
# Restríngela por referrers a https://javiersanzgarcia.github.io/* y
# http://localhost:5173/* en Google Cloud antes de usarla en producción.
#
# En local, pega tu clave en .env.
# En GitHub Pages, crea la variable de repositorio VITE_YOUTUBE_API_KEY.
VITE_YOUTUBE_API_KEY=

# Clave de Gemini API (opcional) para comparar fingerprints semánticos.
# Se obtiene en Google AI Studio y debe tener Generative Language API habilitada.
# La variable VITE_* se incluye en el JavaScript público de la PWA: no uses una
# clave compartida en una publicación pública.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.8-flash
